{
  "functions": [
    {
      "source": "pfasApi_code",
      "codebase": "default",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "test",
        "test-*.js",
        "clean.js",
        "seed.js",
        "migrate-links.js",
        "fix-all-links.js",
        "run-scraper-now.js"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "pfasApi",
        "region": "us-central1"
      }
    ],
    "headers": [
      {
        "source": "/gemeenten.geojson",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
